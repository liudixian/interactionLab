// ============================================================================
// Niagara Custom HLSL 节点粘贴模板 - 在 RenderTarget 2D 上画线段
//
// 用法:
// 1. Niagara Emitter 中添加 "Render Target 2D" Data Interface, 命名为 RT
// 2. 在 Particle Update (GPU) 阶段加 Custom HLSL 节点
// 3. 粘贴本文件全部内容到节点
// 4. 节点会自动生成输入引脚 (A/B/Color/Thickness), 在 Stack 中绑定参数
// 5. Emitter 发射 1 个粒子 = 画 1 条线; 多粒子 = 画多条线
//
// 关键 API (UE 5.8 Niagara RT 2D DI):
//   RT.SetRenderTargetValue(bool Enabled, int X, int Y, LinearColor Value)
// ============================================================================

// ---- 输入引脚 (顶层声明自动生成) ----
float2 A;                // 线段起点 (像素坐标)
float2 B;                // 线段终点 (像素坐标)
float4 Color;            // 颜色 RGBA (linear, 0-1)
float  Thickness;        // 线宽 (像素)

// ---- 函数库 ----
struct GR2DFunctions
{
    float sdLine(float2 P, float2 A_in, float2 B_in)
    {
        float2 PA = P - A_in;
        float2 BA = B_in - A_in;
        float t = saturate(dot(PA, BA) / max(dot(BA, BA), 1e-8));
        return length(PA - BA * t);
    }

    float strokeMask(float dist, float thickness)
    {
        float halfT = max(thickness, 1.0) * 0.5;
        return 1.0 - smoothstep(halfT - 0.5, halfT + 0.5, dist);
    }

    float4 alphaOver(float4 Dest, float4 Src)
    {
        float outA = Src.a + Dest.a * (1.0 - Src.a);
        float3 outRGB = (Src.rgb * Src.a + Dest.rgb * Dest.a * (1.0 - Src.a))
                      / max(outA, 1e-6);
        return float4(outRGB, outA);
    }
};
GR2DFunctions f;

// ---- 主逻辑: 遍历 bbox 像素, 计算 mask, 写入 RT ----

// 1) bbox (含线宽余量)
float2 bmin = min(A, B) - Thickness;
float2 bmax = max(A, B) + Thickness;
int2 pmin = int2(floor(bmin));
int2 pmax = int2(ceil(bmax));

// 2) 遍历像素 (Niagara HLSL 支持动态循环, 但建议 bbox 不要过大)
for (int y = pmin.y; y <= pmax.y; y++)
{
    for (int x = pmin.x; x <= pmax.x; x++)
    {
        float2 p = float2(x, y);
        float d = f.sdLine(p, A, B);
        float m = f.strokeMask(d, Thickness);

        if (m > 0.001)
        {
            float4 src = float4(Color.rgb, Color.a * m);
            RT.SetRenderTargetValue(true, x, y, src);
        }
    }
}
